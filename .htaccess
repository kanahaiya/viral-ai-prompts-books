# =============================================================================
#  Root .htaccess — AI Prompt Books
#  Apache 2.4 + mod_rewrite + mod_headers
# =============================================================================

Options -Indexes -MultiViews
ServerSignature Off

# Force production runtime on hosting (ensures auth.php loads config.production.php)
SetEnv APP_ENV production

# -----------------------------------------------------------------------------
# Rewrite engine
# -----------------------------------------------------------------------------
RewriteEngine On
RewriteBase /

# Force canonical host + HTTPS
# http://aipromptbooks.in/*      -> https://www.aipromptbooks.in/*
# https://aipromptbooks.in/*     -> https://www.aipromptbooks.in/*
# http://www.aipromptbooks.in/*  -> https://www.aipromptbooks.in/*
RewriteCond %{HTTP_HOST} !^www\.aipromptbooks\.in$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^ https://www.aipromptbooks.in%{REQUEST_URI} [L,R=301]

# Remove trailing slash from non-directories
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# -----------------------------------------------------------------------------
# Block direct access to sensitive files
# -----------------------------------------------------------------------------

# config files and auth bootstrap — never served directly
<FilesMatch "^(config|config\.production|auth)\.php$">
    Require all denied
</FilesMatch>

# Never expose local setup helper or local SQLite files
<FilesMatch "^(setup-local)\.php$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(db|sqlite|sqlite3)$">
    Require all denied
</FilesMatch>

# Block dotfiles (.env, .git, .htpasswd, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block backup / editor artefacts
<FilesMatch "\.(bak|swp|swo|orig|log|sql|sh|py|ini|DS_Store)$">
    Require all denied
</FilesMatch>

# db.sql — should never be in webroot, but block it just in case
<FilesMatch "^db\.sql$">
    Require all denied
</FilesMatch>

# -----------------------------------------------------------------------------
# Security headers
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options    "nosniff"
    Header always set X-Frame-Options           "SAMEORIGIN"
    Header always set X-XSS-Protection          "1; mode=block"
    Header always set Referrer-Policy           "strict-origin-when-cross-origin"
    Header always set Permissions-Policy        "geolocation=(), microphone=(), camera=()"

    # Strict-Transport-Security (1 year, include sub-domains)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Basic CSP — tighten once you know all external domains
    Header always set Content-Security-Policy \
        "default-src 'self'; \
         script-src 'self' 'unsafe-inline' 'unsafe-eval' https://connect.facebook.net https://static.cloudflareinsights.com https://checkout.razorpay.com https://cdn.razorpay.com https://sdk.cashfree.com https://www.paypal.com https://www.paypalobjects.com; \
         style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; \
         font-src 'self' https://fonts.gstatic.com; \
         img-src 'self' data: https:; \
         connect-src 'self' https://www.facebook.com https://*.facebook.com https://*.us-central1.run.app https://*.ecs.us-west-2.on.aws https://cloudflareinsights.com https://api.razorpay.com https://lumberjack.razorpay.com https://sdk.cashfree.com https://api.cashfree.com https://sandbox.cashfree.com https://www.paypal.com https://api-m.paypal.com https://api-m.sandbox.paypal.com; \
         frame-src 'self' https://checkout.razorpay.com https://api.razorpay.com https://sdk.cashfree.com https://api.cashfree.com https://sandbox.cashfree.com https://www.paypal.com; \
         object-src 'none'; \
         base-uri 'self';"

    # Remove PHP version disclosure
    Header always unset X-Powered-By
</IfModule>

# -----------------------------------------------------------------------------
# MIME types
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType application/json        .json
    AddType text/javascript         .js
    AddType text/css                .css
    AddType image/avif              .avif
    AddType image/webp              .webp
</IfModule>

# -----------------------------------------------------------------------------
# Compression
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/json text/javascript
    AddOutputFilterByType DEFLATE application/x-javascript application/javascript
    AddOutputFilterByType DEFLATE application/xml text/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css
    AddOutputFilterByType BROTLI_COMPRESS application/json text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/xml text/xml
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
    AddOutputFilterByType BROTLI_COMPRESS font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

<IfModule mod_headers.c>
    Header append Vary "Accept-Encoding"
</IfModule>

# -----------------------------------------------------------------------------
# Browser caching for static assets
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType text/javascript           "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/avif                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"
    ExpiresByType application/pdf           "access plus 1 month"
    ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|mjs|png|jpe?g|webp|avif|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(?:html)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# -----------------------------------------------------------------------------
# Custom error pages
# -----------------------------------------------------------------------------
ErrorDocument 403 /index.php
ErrorDocument 404 /index.php
ErrorDocument 500 /index.php

# -----------------------------------------------------------------------------
# Protect session cookies (belt-and-suspenders alongside PHP settings)
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always edit Set-Cookie "^(.*)$" "$1; HttpOnly; Secure; SameSite=Lax"
</IfModule>
